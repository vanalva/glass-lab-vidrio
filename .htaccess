# BEGIN clean-urls (generated by projects/glass-lab/tools/post-build.mjs, do not edit)
RewriteEngine On
RewriteBase /

# 301: old .html URLs -> clean URLs (only when the request itself asked for .html)
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:index|gl-index)\.html[?\s]
RewriteRule ^(?:index|gl-index)\.html$ / [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:gl-blog-post|blog-post)\.html[?\s]
RewriteRule ^(?:gl-blog-post|blog-post)\.html$ /blog-post [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:gl-blog|blog)\.html[?\s]
RewriteRule ^(?:gl-blog|blog)\.html$ /blog [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:gl-catalogo|catalogo)\.html[?\s]
RewriteRule ^(?:gl-catalogo|catalogo)\.html$ /catalogo [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:gl-contacto|contacto)\.html[?\s]
RewriteRule ^(?:gl-contacto|contacto)\.html$ /contacto [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:gl-instalaciones|instalaciones)\.html[?\s]
RewriteRule ^(?:gl-instalaciones|instalaciones)\.html$ /instalaciones [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:gl-laboratorio|laboratorio)\.html[?\s]
RewriteRule ^(?:gl-laboratorio|laboratorio)\.html$ /laboratorio [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:gl-proyecto|proyecto)\.html[?\s]
RewriteRule ^(?:gl-proyecto|proyecto)\.html$ /proyecto [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:gl-proyectos|proyectos)\.html[?\s]
RewriteRule ^(?:gl-proyectos|proyectos)\.html$ /proyectos [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:gl-vidrio-at|vidrio-at)\.html[?\s]
RewriteRule ^(?:gl-vidrio-at|vidrio-at)\.html$ /vidrio-at [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:gl-vidrio|vidrio)\.html[?\s]
RewriteRule ^(?:gl-vidrio|vidrio)\.html$ /vidrio [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:gl-visor|visor)\.html[?\s]
RewriteRule ^(?:gl-visor|visor)\.html$ /visor [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:legal-cookies|cookies)\.html[?\s]
RewriteRule ^(?:legal-cookies|cookies)\.html$ /cookies [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:legal-privacidad|privacidad)\.html[?\s]
RewriteRule ^(?:legal-privacidad|privacidad)\.html$ /privacidad [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/(?:legal-terminos|terminos)\.html[?\s]
RewriteRule ^(?:legal-terminos|terminos)\.html$ /terminos [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/testimonial\.html[?\s]
RewriteRule ^testimonial\.html$ /testimonial [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:index|gl-index)\.html[?\s]
RewriteRule ^en/(?:index|gl-index)\.html$ /en/ [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:gl-blog-post|blog-post)\.html[?\s]
RewriteRule ^en/(?:gl-blog-post|blog-post)\.html$ /en/blog-post [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:gl-blog|blog)\.html[?\s]
RewriteRule ^en/(?:gl-blog|blog)\.html$ /en/blog [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:gl-catalogo|catalogo)\.html[?\s]
RewriteRule ^en/(?:gl-catalogo|catalogo)\.html$ /en/catalogo [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:gl-contacto|contacto)\.html[?\s]
RewriteRule ^en/(?:gl-contacto|contacto)\.html$ /en/contacto [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:gl-instalaciones|instalaciones)\.html[?\s]
RewriteRule ^en/(?:gl-instalaciones|instalaciones)\.html$ /en/instalaciones [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:gl-laboratorio|laboratorio)\.html[?\s]
RewriteRule ^en/(?:gl-laboratorio|laboratorio)\.html$ /en/laboratorio [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:gl-proyecto|proyecto)\.html[?\s]
RewriteRule ^en/(?:gl-proyecto|proyecto)\.html$ /en/proyecto [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:gl-proyectos|proyectos)\.html[?\s]
RewriteRule ^en/(?:gl-proyectos|proyectos)\.html$ /en/proyectos [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:gl-vidrio-at|vidrio-at)\.html[?\s]
RewriteRule ^en/(?:gl-vidrio-at|vidrio-at)\.html$ /en/vidrio-at [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:gl-vidrio|vidrio)\.html[?\s]
RewriteRule ^en/(?:gl-vidrio|vidrio)\.html$ /en/vidrio [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:gl-visor|visor)\.html[?\s]
RewriteRule ^en/(?:gl-visor|visor)\.html$ /en/visor [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:legal-cookies|cookies)\.html[?\s]
RewriteRule ^en/(?:legal-cookies|cookies)\.html$ /en/cookies [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:legal-privacidad|privacidad)\.html[?\s]
RewriteRule ^en/(?:legal-privacidad|privacidad)\.html$ /en/privacidad [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/(?:legal-terminos|terminos)\.html[?\s]
RewriteRule ^en/(?:legal-terminos|terminos)\.html$ /en/terminos [R=301,L]
RewriteCond %{THE_REQUEST} ^[A-Z]+\s/en/testimonial\.html[?\s]
RewriteRule ^en/testimonial\.html$ /en/testimonial [R=301,L]

# trailing slash -> no slash
RewriteRule ^blog-post/$ /blog-post [R=301,L]
RewriteRule ^blog/$ /blog [R=301,L]
RewriteRule ^catalogo/$ /catalogo [R=301,L]
RewriteRule ^contacto/$ /contacto [R=301,L]
RewriteRule ^instalaciones/$ /instalaciones [R=301,L]
RewriteRule ^laboratorio/$ /laboratorio [R=301,L]
RewriteRule ^proyecto/$ /proyecto [R=301,L]
RewriteRule ^proyectos/$ /proyectos [R=301,L]
RewriteRule ^vidrio-at/$ /vidrio-at [R=301,L]
RewriteRule ^vidrio/$ /vidrio [R=301,L]
RewriteRule ^visor/$ /visor [R=301,L]
RewriteRule ^cookies/$ /cookies [R=301,L]
RewriteRule ^privacidad/$ /privacidad [R=301,L]
RewriteRule ^terminos/$ /terminos [R=301,L]
RewriteRule ^testimonial/$ /testimonial [R=301,L]
RewriteRule ^en/blog-post/$ /en/blog-post [R=301,L]
RewriteRule ^en/blog/$ /en/blog [R=301,L]
RewriteRule ^en/catalogo/$ /en/catalogo [R=301,L]
RewriteRule ^en/contacto/$ /en/contacto [R=301,L]
RewriteRule ^en/instalaciones/$ /en/instalaciones [R=301,L]
RewriteRule ^en/laboratorio/$ /en/laboratorio [R=301,L]
RewriteRule ^en/proyecto/$ /en/proyecto [R=301,L]
RewriteRule ^en/proyectos/$ /en/proyectos [R=301,L]
RewriteRule ^en/vidrio-at/$ /en/vidrio-at [R=301,L]
RewriteRule ^en/vidrio/$ /en/vidrio [R=301,L]
RewriteRule ^en/visor/$ /en/visor [R=301,L]
RewriteRule ^en/cookies/$ /en/cookies [R=301,L]
RewriteRule ^en/privacidad/$ /en/privacidad [R=301,L]
RewriteRule ^en/terminos/$ /en/terminos [R=301,L]
RewriteRule ^en/testimonial/$ /en/testimonial [R=301,L]

# serve each clean path from its file
RewriteRule ^blog-post$ gl-blog-post.html [L]
RewriteRule ^blog$ gl-blog.html [L]
RewriteRule ^catalogo$ gl-catalogo.html [L]
RewriteRule ^contacto$ gl-contacto.html [L]
RewriteRule ^instalaciones$ gl-instalaciones.html [L]
RewriteRule ^laboratorio$ gl-laboratorio.html [L]
RewriteRule ^proyecto$ gl-proyecto.html [L]
RewriteRule ^proyectos$ gl-proyectos.html [L]
RewriteRule ^vidrio-at$ gl-vidrio-at.html [L]
RewriteRule ^vidrio$ gl-vidrio.html [L]
RewriteRule ^visor$ gl-visor.html [L]
RewriteRule ^cookies$ legal-cookies.html [L]
RewriteRule ^privacidad$ legal-privacidad.html [L]
RewriteRule ^terminos$ legal-terminos.html [L]
RewriteRule ^testimonial$ testimonial.html [L]
RewriteRule ^en/blog-post$ en/gl-blog-post.html [L]
RewriteRule ^en/blog$ en/gl-blog.html [L]
RewriteRule ^en/catalogo$ en/gl-catalogo.html [L]
RewriteRule ^en/contacto$ en/gl-contacto.html [L]
RewriteRule ^en/instalaciones$ en/gl-instalaciones.html [L]
RewriteRule ^en/laboratorio$ en/gl-laboratorio.html [L]
RewriteRule ^en/proyecto$ en/gl-proyecto.html [L]
RewriteRule ^en/proyectos$ en/gl-proyectos.html [L]
RewriteRule ^en/vidrio-at$ en/gl-vidrio-at.html [L]
RewriteRule ^en/vidrio$ en/gl-vidrio.html [L]
RewriteRule ^en/visor$ en/gl-visor.html [L]
RewriteRule ^en/cookies$ en/legal-cookies.html [L]
RewriteRule ^en/privacidad$ en/legal-privacidad.html [L]
RewriteRule ^en/terminos$ en/legal-terminos.html [L]
RewriteRule ^en/testimonial$ en/testimonial.html [L]

ErrorDocument 404 /404.html
# END clean-urls
